<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_stock_quant_tree_beeloo_internal" model="ir.ui.view">
        <field name="name">stock.quant.tree.beeloo.internal</field>
        <field name="model">stock.quant</field>
        <field name="inherit_id" ref="stock.view_stock_quant_tree_inventory_editable"/>
        <field name="arch" type="xml">
            
            <field name="quantity" position="after">
                <field name="x_pallet_qty" 
                       string="Qtd (Paletes)"
                       optional="show" 
                       decoration-bf="x_pallet_qty >= 1.0"
                       decoration-info="x_pallet_qty &lt; 1.0 and x_pallet_qty > 0"/>
            </field>

        </field>
    </record>
    
    <record id="view_stock_quant_tree_simple_beeloo_internal" model="ir.ui.view">
        <field name="name">stock.quant.tree.simple.beeloo.internal</field>
        <field name="model">stock.quant</field>
        <field name="inherit_id" ref="stock.view_stock_quant_tree_simple"/>
        <field name="arch" type="xml">
            <field name="quantity" position="after">
                 <field name="x_pallet_qty" optional="show" string="Paletes"/>
            </field>
        </field>
    </record>
</odoo>