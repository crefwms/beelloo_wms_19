<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Sequence for RMA -->
        <record id="seq_reverse_logistics_rma" model="ir.sequence">
            <field name="name">Reverse Logistics RMA</field>
            <field name="code">reverse.logistics.rma</field>
            <field name="prefix">RMA/%(year)s/</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>

        <!-- Sequence for Batch -->
        <record id="seq_reverse_logistics_batch" model="ir.sequence">
            <field name="name">Reverse Collection Batch</field>
            <field name="code">reverse.logistics.batch</field>
            <field name="prefix">BATCH/%(year)s/</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>

        <!-- Default Locations -->
        <record id="location_reverse_quarantine" model="stock.location">
            <field name="name">Quarentena Reversa</field>
            <field name="location_id" ref="stock.stock_location_stock"/>
            <field name="usage">internal</field>
        </record>

        <record id="location_reverse_inspection" model="stock.location">
            <field name="name">Triagem Técnica</field>
            <field name="location_id" ref="stock.stock_location_stock"/>
            <field name="usage">internal</field>
        </record>
    </data>
</odoo>
