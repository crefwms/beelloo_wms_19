<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_reverse_logistics_safety_checklist_tree" model="ir.ui.view">
        <field name="name">reverse.logistics.safety.checklist.tree</field>
        <field name="model">reverse.logistics.safety.checklist</field>
        <field name="arch" type="xml">
            <list>
                <field name="name" string="Checklist"/>
                <field name="check_leakage" string="Vazamentos?"/>
                <field name="check_battery" string="Bateria?"/>
                <field name="epi_required" string="EPI Necessário"/>
            </list>
        </field>
    </record>

    <record id="view_reverse_logistics_safety_log_tree" model="ir.ui.view">
        <field name="name">reverse.logistics.safety.log.tree</field>
        <field name="model">reverse.logistics.safety.log</field>
        <field name="arch" type="xml">
            <list>
                <field name="checklist_id" string="Checklist"/>
                <field name="user_id" string="Inspecionado por"/>
                <field name="date_inspection" string="Data"/>
                <field name="is_safe" string="Seguro?"/>
            </list>
        </field>
    </record>

    <record id="action_reverse_logistics_safety_checklist" model="ir.actions.act_window">
        <field name="name">Checklists de Segurança</field>
        <field name="res_model">reverse.logistics.safety.checklist</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
