<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_rastreabilidade_veiculo_list" model="ir.ui.view">
        <field name="name">rastreabilidade.veiculo.list</field>
        <field name="model">rastreabilidade.veiculo</field>
        <field name="arch" type="xml">
            <list string="Veículos">
                <field name="placa"/>
                <field name="tipo"/>
                <field name="transportadora_id"/>
            </list>
        </field>
    </record>

    <record id="view_rastreabilidade_veiculo_form" model="ir.ui.view">
        <field name="name">rastreabilidade.veiculo.form</field>
        <field name="model">rastreabilidade.veiculo</field>
        <field name="arch" type="xml">
            <form string="Veículo">
                <sheet>
                    <group>
                        <group>
                            <field name="placa" placeholder="Ex: ABC-1234"/>
                            <field name="tipo"/>
                        </group>
                        <group>
                            <field name="transportadora_id" options="{'no_create': True}"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
</odoo>