<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="view_beeloo_wms_kpi_history_list" model="ir.ui.view">
            <field name="name">beeloo.wms.kpi.history.list</field>
            <field name="model">beeloo.wms.kpi.history</field>
            <field name="arch" type="xml">
                <list string="Histórico de KPIs" default_order="date desc">
                    <field name="date" optional="show"/>
                    <field name="warehouse_id" optional="show"/>
                    <field name="total_pallets_stored" optional="show" sum="Total Paletes"/>
                    <field name="total_footprints_occupied" optional="show" sum="Total Footprints"/>
                    <field name="total_locations_capacity" optional="show"/>
                    <field name="standard_stacking_factor" optional="hide"/>
                    <field name="avg_stacking_factor" optional="show" widget="progressbar"/>
                </list>
            </field>
        </record>

        <record id="view_beeloo_wms_kpi_history_form" model="ir.ui.view">
            <field name="name">beeloo.wms.kpi.history.form</field>
            <field name="model">beeloo.wms.kpi.history</field>
            <field name="arch" type="xml">
                <form string="Registro de KPI">
                    <sheet>
                        <group>
                            <group>
                                <field name="date"/>
                                <field name="warehouse_id"/>
                            </group>
                            <group>
                                <field name="total_locations_capacity"/>
                                <field name="standard_stacking_factor"/>
                            </group>
                        </group>
                        <group string="Cálculos do 'Motor'">
                            <field name="total_pallets_stored"/>
                            <field name="total_footprints_occupied"/>
                            <field name="avg_stacking_factor"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="action_beeloo_wms_kpi_history" model="ir.actions.act_window">
            <field name="name">Histórico de KPIs</field>
            <field name="res_model">beeloo.wms.kpi.history</field>
            <field name="view_mode">list,form</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Nenhum registro de KPI encontrado.
                    O "Motor" (Ação Agendada) precisa rodar para gerar os dados.
                </p>
            </field>
        </record>

        <menuitem id="menu_beeloo_wms_kpi_history"
                  name="Histórico de KPIs (Diário)"
                  parent="stock.menu_stock_inventory_control"
                  action="action_beeloo_wms_kpi_history"
                  sequence="110"/>

    </data>
</odoo>