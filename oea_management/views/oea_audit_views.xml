<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_oea_audit_search" model="ir.ui.view">
        <field name="name">oea.audit.search</field>
        <field name="model">oea.audit</field>
        <field name="arch" type="xml">
            <search string="Buscar Auditorias">
                <field name="name"/>
                <field name="company_id"/>
                <filter string="Este Mês" name="this_month" domain="[('date', '>=', context_today().strftime('%Y-%m-01'))]"/>
                <filter string="Este Ano" name="this_year" domain="[('date', '>=', context_today().strftime('%Y-01-01'))]"/>
                <group expand="0" string="Agrupar por">
                    <filter string="Empresa" name="group_company" context="{'group_by': 'company_id'}"/>
                    <filter string="Mês" name="group_month" context="{'group_by': 'date:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_oea_audit_tree" model="ir.ui.view">
        <field name="name">oea.audit.tree</field>
        <field name="model">oea.audit</field>
        <field name="arch" type="xml">
            <list string="Auditorias OEA">
                <field name="name"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="date"/>
                <field name="progress" widget="progressbar"/>
            </list>
        </field>
    </record>

    <record id="view_oea_audit_form" model="ir.ui.view">
        <field name="name">oea.audit.form</field>
        <field name="model">oea.audit</field>
        <field name="arch" type="xml">
            <form string="Auditoria OEA">
                <header>
                    <button name="action_generate_checklist" string="Gerar Check-list" type="object" class="oe_highlight"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_action_items" type="object" class="oe_stat_button" icon="fa-check-square-o">
                            <field name="action_item_count" string="Itens de Ação" widget="statinfo"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group>
                            <field name="date"/>
                            <field name="progress" widget="progressbar"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Itens de Conformidade" name="lines">
                            <field name="line_ids">
                                <list editable="bottom">
                                    <field name="requirement_id"/>
                                    <field name="action_item_id"/>
                                    <field name="status" widget="badge" 
                                           decoration-success="status == 'validated'"
                                           decoration-warning="status == 'in_progress'"
                                           decoration-danger="status == 'rejected'"
                                           decoration-info="status == 'not_applicable'"/>
                                    <field name="notes"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_oea_audit" model="ir.actions.act_window">
        <field name="name">Auditorias / Conformidade</field>
        <field name="res_model">oea.audit</field>
        <field name="view_mode">list,form,kanban</field>
    </record>

    <record id="action_report_oea_audit" model="ir.actions.report">
        <field name="name">Relatório de Auditoria</field>
        <field name="model">oea.audit</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">oea_management.oea_audit_report</field>
        <field name="report_file">oea_management.oea_audit_report</field>
    </record>
</odoo>
