<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_oea_risk_search" model="ir.ui.view">
        <field name="name">oea.risk.search</field>
        <field name="model">oea.risk</field>
        <field name="arch" type="xml">
            <search string="Buscar Riscos">
                <field name="name"/>
                <field name="asset_id"/>
                <filter string="Críticos" name="critical" domain="[('risk_rating', '=', 'critical')]"/>
                <filter string="Altos" name="high" domain="[('risk_rating', '=', 'high')]"/>
                <filter string="Abertos" name="open" domain="[('state', '!=', 'closed')]"/>
                <filter string="Encerrados" name="closed" domain="[('state', '=', 'closed')]"/>
                <group expand="0" string="Agrupar por">
                    <filter string="Classificação" name="group_rating" context="{'group_by': 'risk_rating'}"/>
                    <filter string="Status" name="group_state" context="{'group_by': 'state'}"/>
                    <filter string="Ativo" name="group_asset" context="{'group_by': 'asset_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_oea_risk_tree" model="ir.ui.view">
        <field name="name">oea.risk.tree</field>
        <field name="model">oea.risk</field>
        <field name="arch" type="xml">
            <list string="Gestão de Riscos" decoration-danger="risk_rating == 'critical'" decoration-warning="risk_rating == 'high'" decoration-info="risk_rating == 'medium'">
                <field name="name"/>
                <field name="asset_id"/>
                <field name="risk_level"/>
                <field name="risk_rating" widget="badge"/>
                <field name="treatment_strategy"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="view_oea_risk_form" model="ir.ui.view">
        <field name="name">oea.risk.form</field>
        <field name="model">oea.risk</field>
        <field name="arch" type="xml">
            <form string="Análise de Risco">
                <header>
                    <button name="action_analyze" type="object" string="Iniciar Análise" class="oe_highlight" invisible="state != 'draft'"/>
                    <button name="action_treat" type="object" string="Iniciar Tratamento" class="oe_highlight" invisible="state != 'analysis'"/>
                    <button name="action_close" type="object" string="Encerrar" class="oe_success" invisible="state != 'treatment'"/>
                    <button name="action_draft" type="object" string="Voltar para Identificado" invisible="state == 'draft'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,analysis,treatment,closed" options="{'clickable': '1'}"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Título do Risco..."/>
                        </h1>
                    </div>
                    <group>
                        <group string="Identificação">
                            <field name="asset_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group string="Avaliação (Matriz 5x5)">
                            <field name="impact"/>
                            <field name="probability"/>
                            <field name="risk_level"/>
                            <field name="risk_rating" widget="badge"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Análise" name="analysis">
                            <group>
                                <field name="threat"/>
                                <field name="vulnerability"/>
                            </group>
                        </page>
                        <page string="Tratamento" name="treatment">
                            <group>
                                <field name="treatment_strategy"/>
                                <field name="control_action"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_oea_risk" model="ir.actions.act_window">
        <field name="name">Matriz de Riscos</field>
        <field name="res_model">oea.risk</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_oea_risk"
              name="Análise de Riscos"
              action="action_oea_risk"
              parent="menu_oea_main"
              sequence="20"/>
</odoo>
