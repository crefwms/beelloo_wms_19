<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_oea_import_trello_form" model="ir.ui.view">
        <field name="name">oea.import.trello.form</field>
        <field name="model">oea.import.trello</field>
        <field name="arch" type="xml">
            <form string="Importar Requisitos do Trello">
                <group>
                    <field name="json_file" filename="file_name"/>
                    <field name="file_name" invisible="1"/>
                </group>
                <footer>
                    <button name="action_import" string="Importar" type="object" class="btn-primary"/>
                    <button string="Cancelar" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_oea_import_trello" model="ir.actions.act_window">
        <field name="name">Importar do Trello</field>
        <field name="res_model">oea.import.trello</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
