<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Kanban View -->
    <record id="view_tosign_document_kanban" model="ir.ui.view">
        <field name="name">tosign.document.kanban</field>
        <field name="model">tosign.document</field>
        <field name="arch" type="xml">
            <kanban>
                <field name="name"/>
                <field name="file_type"/>
                <field name="state"/>
                <field name="signed_by"/>
                <field name="signed_date"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click">
                            <div class="o_kanban_card_header">
                                <div class="o_kanban_card_header_title">
                                    <div class="o_primary">
                                        <field name="name"/>
                                    </div>
                                    <div class="o_secondary">
                                        <field name="file_name"/>
                                    </div>
                                </div>
                                <div class="o_kanban_avatar">
                                    <field name="signed_by" widget="image" options="{'preview_image': 'avatar_128'}"/>
                                </div>
                            </div>
                            <div class="o_kanban_card_body">
                                <div class="o_kanban_tags">
                                    <span class="o_tag o_tag_float" t-attf-class="o_tag_badge o_tag_badge_notification 
                                        tagi-bg-#{record.state.raw_value == 'draft' ? 'info' : 
                                                         record.state.raw_value == 'pending' ? 'warning' : 
                                                         record.state.raw_value == 'signed' ? 'success' : 'danger'}">
                                        <field name="state"/>
                                    </span>
                                </div>
                            </div>
                            <div class="o_kanban_card_footer">
                                <field name="signed_date"/>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- List View -->
    <record id="view_tosign_document_list" model="ir.ui.view">
        <field name="name">tosign.document.list</field>
        <field name="model">tosign.document</field>
        <field name="arch" type="xml">
            <list string="Documentos" decoration-success="state=='signed'" decoration-warning="state=='pending'" decoration-muted="state=='cancelled'">
                <field name="name"/>
                <field name="file_name"/>
                <field name="file_type"/>
                <field name="state"/>
                <field name="signed_by"/>
                <field name="signed_date"/>
                <field name="create_date"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_tosign_document_form" model="ir.ui.view">
        <field name="name">tosign.document.form</field>
        <field name="model">tosign.document</field>
        <field name="arch" type="xml">
            <form string="Documento">
                <header>
                    <button name="action_pending" string="Enviar para Assinatura" type="object" 
                            class="btn-primary" invisible="state != 'draft'"/>
                    <button name="%(action_sign_wizard)d" string="Assinar Documento" type="action"
                            class="btn-success" invisible="state != 'pending'"/>
                    <button name="action_cancel" string="Cancelar" type="object"
                            class="btn-danger" invisible="state not in ('draft', 'pending')"/>
                    <button name="action_reset_draft" string="Voltar para Rascunho" type="object"
                            invisible="state != 'cancelled'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,pending,signed"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="file_name" invisible="1"/>
                            <field name="file" widget="pdf_viewer" filename="file_name" 
                                   invisible="file_type != 'pdf'" required="1"/>
                            <field name="file" widget="binary_file" filename="file_name" 
                                   invisible="file_type == 'pdf'" required="1"/>
                            <field name="file_type"/>
                            <field name="partner_id"/>
                        </group>
                        <group>
                            <field name="signed_by" readonly="1"/>
                            <field name="signed_date" readonly="1"/>
                        </group>
                    </group>
                    <group string="Assinatura e Rúbrica" invisible="state != 'signed'">
                        <group>
                            <field name="has_signature" readonly="1"/>
                            <field name="signature_image" widget="image" options="{'size': [200, 100]}"
                                   invisible="not has_signature"/>
                        </group>
                        <group>
                            <field name="has_rubric" readonly="1"/>
                            <field name="rubric_image" widget="image" options="{'size': [100, 50]}"
                                   invisible="not has_rubric"/>
                        </group>
                        <div colspan="2" class="alert alert-success" role="alert">
                            <strong>Documento assinado digitalmente</strong>
                            <dl class="row mt-1">
                                <dt class="col-4">Assinado por:</dt>
                                <dd class="col-8">
                                    <field name="signed_by" readonly="1" widget="many2one_avatar_user"/>
                                </dd>
                                <dt class="col-4">Data:</dt>
                                <dd class="col-8"><field name="signed_date" readonly="1"/></dd>
                                <dt class="col-4">Hash SHA-256:</dt>
                                <dd class="col-8"><field name="document_hash" readonly="1"/></dd>
                            </dl>
                        </div>
                        <group>
                            <field name="signature_metadata" widget="text" readonly="1"
                                   invisible="not signature_metadata"/>
                        </group>
                    </group>
                    <group string="Descrição">
                        <field name="description"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Search View -->
    <record id="view_tosign_document_search" model="ir.ui.view">
        <field name="name">tosign.document.search</field>
        <field name="model">tosign.document</field>
        <field name="arch" type="xml">
            <search string="Buscar Documentos">
                <field name="name"/>
                <field name="file_name"/>
                <filter string="Rascunho" name="draft" domain="[('state', '=', 'draft')]"/>
                <filter string="Pendente" name="pending" domain="[('state', '=', 'pending')]"/>
                <filter string="Assinado" name="signed" domain="[('state', '=', 'signed')]"/>
                <filter string="Cancelado" name="cancelled" domain="[('state', '=', 'cancelled')]"/>
                <group expand="0" string="Group By">
                    <filter string="Status" name="group_state" context="{'group_by': 'state'}"/>
                    <filter string="Data" name="group_date" context="{'group_by': 'signed_date'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="action_tosign_document" model="ir.actions.act_window">
        <field name="name">Documentos para Assinatura</field>
        <field name="res_model">tosign.document</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Nenhum documento ainda. Clique em Criar para adicionar.
            </p>
        </field>
    </record>
</odoo>
