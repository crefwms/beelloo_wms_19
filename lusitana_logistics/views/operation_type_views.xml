<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="lusitana_logistics_operation_type_list_view" model="ir.ui.view">
            <field name="name">lusitana_logistics.operation.type.list</field>
            <field name="model">lusitana_logistics.operation_type</field>
            <field name="arch" type="xml">
                <list string="Tipos de Operação">
                    <field name="name"/>
                    <field name="direction"/>
                    <field name="code"/>
                </list>
            </field>
        </record>

        <record id="lusitana_logistics_operation_type_form_view" model="ir.ui.view">
            <field name="name">lusitana_logistics.operation.type.form</field>
            <field name="model">lusitana_logistics.operation_type</field>
            <field name="arch" type="xml">
                <form string="Tipo de Operação">
                    <sheet>
                        <group>
                            <field name="name"/>
                            <field name="direction"/>
                            <field name="code"/>
                        </group>
                        <group string="Regras de Validação">
                            <field name="requires_cliente"/>
                            <field name="requires_origem"/>
                            <field name="requires_destino"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="lusitana_logistics_operation_type_action" model="ir.actions.act_window">
            <field name="name">Tipos de Operação</field>
            <field name="res_model">lusitana_logistics.operation_type</field>
            <field name="view_mode">list,form</field>
        </record>
    </data>
</odoo>