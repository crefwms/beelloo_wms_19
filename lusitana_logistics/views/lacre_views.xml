<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="lusitana_logistics_lacre_list_view" model="ir.ui.view">
            <field name="name">lusitana_logistics.lacre.list</field>
            <field name="model">lusitana_logistics.lacre</field>
            <field name="arch" type="xml">
                <list string="Lacres">
                    <field name="name"/>
                    <field name="tipo_lacre"/>
                    <field name="status"/>
                    <field name="apresentacao_id"/>
                </list>
            </field>
        </record>

        <record id="lusitana_logistics_lacre_form_view" model="ir.ui.view">
            <field name="name">lusitana_logistics.lacre.form</field>
            <field name="model">lusitana_logistics.lacre</field>
            <field name="arch" type="xml">
                <form string="Lacre">
                    <sheet>
                        <div class="oe_button_box" name="button_box"/>
                        <div class="oe_title">
                            <label for="name" class="oe_edit_only"/>
                            <h1><field name="name" modifiers="{'readonly': [('tipo_lacre', '=', 'hnk'), ('name', '!=', False)]}"/>
                            </h1> </div>
                        <group>
                            <group>
                                <field name="tipo_lacre"/>
                                <field name="status"/>
                                <field name="fornecedor_id" modifiers="{'readonly': True}"/>
                            </group>
                        </group>
                        <group string="Observações">
                            <field name="observacoes" nolabel="1"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="lusitana_logistics_lacre_action" model="ir.actions.act_window">
            <field name="name">Lacres</field>
            <field name="res_model">lusitana_logistics.lacre</field>
            <field name="view_mode">list,form</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Gerencie seus lacres aqui!
                </p>
            </field>
        </record>
    </data>
</odoo>