<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_agenda_heineken_list" model="ir.ui.view">
            <field name="name">lusitana.logistics.agenda.heineken.list</field>
            <field name="model">lusitana_logistics.agenda_heineken</field>
            <field name="arch" type="xml">
                <list string="Agenda de Carregamento">
                    <field name="dt_documento"/>
                    <field name="direction" widget="badge"/>
                    <field name="data_agendamento"/>
                    <field name="hora_agendamento"/>
                    <field name="transportadora_id"/>
                    <field name="centro"/>
                    <field name="canal_vendas" widget="badge"/> 
                    <field name="prioridade_id" widget="badge"/> 
                </list>
            </field>
        </record>

        <record id="view_agenda_heineken_form" model="ir.ui.view">
            <field name="name">lusitana.logistics.agenda.heineken.form</field>
            <field name="model">lusitana_logistics.agenda_heineken</field>
            <field name="arch" type="xml">
                <form string="Detalhes da Agenda">
                    <sheet>
                        <div class="oe_title">
                            <label for="dt_documento"/>
                            <h1><field name="dt_documento"/></h1>
                        </div>
                        <group>
                            <group>
                                <field name="transportadora_id"/>
                                <field name="direction"/>
                                <field name="placa_cavalo"/>
                                <field name="placa_carreta"/>
                                <field name="centro"/>
                                <field name="remessa"/>
                            </group>
                            <group>
                                <field name="data_agendamento"/>
                                <field name="hora_agendamento"/>
                                <field name="canal_vendas"/>
                                <field name="prioridade_id"/>
                                <field name="cliente_code"/>
                                <field name="cliente_name" readonly="1"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Produtos Agendados">
                                <field name="line_ids">
                                    <list editable="bottom">
                                        <field name="product_id"/>
                                        <field name="product_descr_sap"/>
                                        <field name="quantidade"/>
                                        <field name="quantidade_paletes"/>
                                    </list>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="action_agenda_heineken" model="ir.actions.act_window">
            <field name="name">Agenda de Carregamento</field>
            <field name="res_model">lusitana_logistics.agenda_heineken</field>
            <field name="view_mode">list,form</field>
        </record>

    </data>
</odoo>