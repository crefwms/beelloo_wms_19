<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="lusitana_logistics_vehicle_list_view" model="ir.ui.view">
            <field name="name">lusitana_logistics.vehicle.list</field>
            <field name="model">lusitana_logistics.vehicle</field>
            <field name="arch" type="xml">
                <list string="Veículos">
                    <field name="name"/> 
                    <field name="transportadora_id"/>
                    <field name="tipo_frota"/>
                    <field name="vehicle_type_id"/>
                    <field name="body_type_id"/>
                    <field name="capacidade_paletes"/>
                    <field name="active"/>
                </list>
            </field>
        </record>

        <record id="lusitana_logistics_vehicle_form_view" model="ir.ui.view">
            <field name="name">lusitana_logistics.vehicle.form</field>
            <field name="model">lusitana_logistics.vehicle</field>
            <field name="arch" type="xml">
                <form string="Veículo">
                    <sheet>
                        <div class="oe_title">
                            <label for="name" class="oe_edit_only"/>
                            <h1><field name="name" placeholder="Ex: ABC-1234"/></h1>
                        </div>
                        <group>
                            <group>
                                <field name="transportadora_id"/>
                                <field name="tipo_frota"/>
                                <field name="vehicle_type_id"/>
                                <field name="body_type_id" modifiers='{"required": [["tipo_frota","in",["implemento","completo"]]], "invisible": [["tipo_frota","=","tracao"]]}'/>
                            </group>
                            <group>
                                <field name="tie_type_id" modifiers='{"invisible": [["tipo_frota","=","tracao"]]}'/>
                                <field name="tightening_type_id" modifiers='{"invisible": [["tipo_frota","=","tracao"]]}'/>
                                <field name="active" widget="boolean_toggle"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Especificações">
                                <group>
                                    <field name="capacidade_paletes"/>
                                    <field name="tara"/>
                                    <field name="pbt"/>
                                    <field name="qtde_eixos"/>
                                </group>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="lusitana_logistics_vehicle_action" model="ir.actions.act_window">
            <field name="name">Veículos</field>
            <field name="res_model">lusitana_logistics.vehicle</field>
            <field name="view_mode">list,form</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Cadastre os veículos que transitam pela sua operação!
                </p>
            </field>
        </record>
    </data>
</odoo>
