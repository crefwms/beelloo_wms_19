<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="lusitana_logistics_tie_type_list_view" model="ir.ui.view">
            <field name="name">lusitana_logistics.tie.type.list</field>
            <field name="model">lusitana_logistics.tie_type</field>
            <field name="arch" type="xml">
                <list string="Tipos de Amarração">
                    <field name="name"/>
                    <field name="description"/>
                </list>
            </field>
        </record>

        <record id="lusitana_logistics_tie_type_form_view" model="ir.ui.view">
            <field name="name">lusitana_logistics.tie.type.form</field>
            <field name="model">lusitana_logistics.tie_type</field>
            <field name="arch" type="xml">
                <form string="Tipo de Amarração">
                    <sheet>
                        <group>
                            <field name="name"/>
                            <field name="description"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="lusitana_logistics_tie_type_action" model="ir.actions.act_window">
            <field name="name">Tipos de Amarração</field>
            <field name="res_model">lusitana_logistics.tie_type</field>
            <field name="view_mode">list,form</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Crie seu primeiro tipo de amarração!
                </p>
            </field>
        </record>
    </data>
</odoo>