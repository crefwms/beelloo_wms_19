<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <record id="module_category_lusitana_logistics" model="ir.module.category">
            <field name="name">Logística Lusitana</field>
            <field name="description">Permissões para o módulo de Logística da Lusitana</field>
            <field name="sequence">20</field>
        </record>

        <record id="group_operador_patio" model="res.groups">
            <field name="name">Operador de Pátio</field>
            <field name="category_id" ref="module_category_lusitana_logistics"/>
        </record>

        <record id="group_gerente_logistica" model="res.groups">
            <field name="name">Gerente de Logística</field>
            <field name="category_id" ref="module_category_lusitana_logistics"/>
            <field name="implied_ids" eval="[(4, ref('group_operador_patio'))]"/>
            <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
        </record>
    </data>
</odoo>