<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="view_beeloo_shelf_life_flow_list" model="ir.ui.view">
            <field name="name">beeloo.shelf.life.flow.list</field>
            <field name="model">beeloo.shelf.life.flow</field>
            <field name="arch" type="xml">
                <list string="Shelf Life Flows">
                    <field name="name"/>
                    <field name="partner_id"/>
                    <field name="product_id"/>
                    <field name="quant_id"/>
                    <field name="offered_date"/>
                    <field name="status"/>
                </list>
            </field>
        </record>

        <record id="view_beeloo_shelf_life_flow_form" model="ir.ui.view">
            <field name="name">beeloo.shelf.life.flow.form</field>
            <field name="model">beeloo.shelf.life.flow</field>
            <field name="arch" type="xml">
                <form string="Shelf Life Flow">
                    <header>
                        <field name="status" widget="statusbar" statusbar_visible="draft,sent,approved,rejected"/>
                    </header>
                    <sheet>
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                        <group>
                            <group>
                                <field name="partner_id"/>
                                <field name="product_id"/>
                                <field name="quant_id" context="{'default_product_id': product_id}"/>
                            </group>
                            <group>
                                <field name="offered_date"/>
                                </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="action_beeloo_shelf_life_flow" model="ir.actions.act_window">
            <field name="name">Shelf Life Flows (Exceções)</field>
            <field name="res_model">beeloo.shelf.life.flow</field>
            <field name="view_mode">list,form</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Nenhum "flow" de exceção de shelf life criado ainda.
                </p>
            </field>
        </record>

    </data>
</odoo>