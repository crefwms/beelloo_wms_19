<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_location_form_inherit_beeloo" model="ir.ui.view">
        <field name="name">stock.location.form.inherit.beeloo</field>
        <field name="model">stock.location</field>
        <field name="inherit_id" ref="stock.view_location_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='usage']" position="after">
                <field name="x_storage_type"/>
                <field name="x_footprint_capacity"/>
                <field name="x_occupancy_percent" widget="progressbar"/>
            </xpath>
        </field>
    </record>

    <record id="stock_location_list_view_inherit_beeloo" model="ir.ui.view">
        <field name="name">stock.location.list.inherit.beeloo</field>
        <field name="model">stock.location</field>
        <field name="inherit_id" ref="stock.view_location_tree2"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='usage']" position="after">
                <field name="x_storage_type" optional="show"/>
                <field name="x_footprint_capacity" optional="show"/>
                <field name="x_occupancy_percent" optional="show" widget="progressbar"/>
            </xpath>
        </field>
    </record>

</odoo>