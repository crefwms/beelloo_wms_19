<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="product_template_form_view_inherit_beeloo" model="ir.ui.view">
        <field name="name">product.template.form.inherit.beeloo</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='inventory']//group[@name='traceability']" position="after">
                <group string="Logística Beeloo (WMS)">
                    <field name="x_product_type"/>
                    <field name="x_sku"/>
                    <field name="x_palletization_qty"/>
                    <field name="x_max_stacking"/>
                    <field name="x_shelf_days"/>
                    <field name="x_veto_days"/>
                    <field name="x_pallet_type_id"/>
                </group>
            </xpath>
        </field>
    </record>

    <record id="product_template_list_view_inherit_beeloo" model="ir.ui.view">
        <field name="name">product.template.list.inherit.beeloo</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_tree_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="after">
                <field name="x_sku" optional="show"/>
                <field name="x_product_type" optional="show"/>
            </xpath>
        </field>
    </record>

</odoo>