<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Record Rule for Multi-tenancy: OSINT Target -->
        <record id="rule_osint_target_multi_company" model="ir.rule">
            <field name="name">OSINT Target: Multi-company</field>
            <field name="model_id" ref="model_osint_target"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <!-- Record Rule for Multi-tenancy: OSINT Result -->
        <record id="rule_osint_result_multi_company" model="ir.rule">
            <field name="name">OSINT Result: Multi-company</field>
            <field name="model_id" ref="model_osint_result"/>
            <field name="domain_force">['|', ('target_id.company_id', '=', False), ('target_id.company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        </record>
    </data>
</odoo>
