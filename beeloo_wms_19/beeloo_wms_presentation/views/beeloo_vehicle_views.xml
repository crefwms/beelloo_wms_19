<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="beeloo_vehicle_view_list" model="ir.ui.view">
        <field name="name">beeloo.vehicle.list</field>
        <field name="model">beeloo.vehicle</field>
        <field name="arch" type="xml">
            <list>
                <field name="name" string="Placa"/>
                <field name="tipo_frota"/>
                <field name="vehicle_type_id"/>
                <field name="body_type_id"/>
                <field name="transportadora_id"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="beeloo_vehicle_view_form" model="ir.ui.view">
        <field name="name">beeloo.vehicle.form</field>
        <field name="model">beeloo.vehicle</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <label for="name" string="Placa"/>
                        <h1><field name="name" placeholder="ABC-1234"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="active" widget="boolean_toggle"/>
                            <field name="tipo_frota"/>
                            <field name="transportadora_id"/>
                        </group>
                        <group>
                            <field name="vehicle_type_id"/>
                            <field name="body_type_id"/>
                            <field name="tie_type_id"/>
                            <field name="tightening_type_id"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Detalhes Logísticos">
                            <group>
                                <field name="capacidade_paletes"/>
                                <field name="tara"/>
                                <field name="pbt"/>
                                <field name="qtde_eixos"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_beeloo_vehicle" model="ir.actions.act_window">
        <field name="name">Cadastro de Veículos</field>
        <field name="res_model">beeloo.vehicle</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem
        id="menu_beeloo_vehicle"
        name="Cadastro de Veículos"
        parent="menu_beeloo_wms_config_vehicle" action="action_beeloo_vehicle"
        sequence="1"/>

</odoo>